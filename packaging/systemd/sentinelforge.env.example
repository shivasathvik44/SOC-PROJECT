# SentinelForge systemd environment file - EXAMPLE.
#
# This file contains no real values and must not be committed with any. Copy
# it to /etc/sentinelforge/sentinelforge.env, edit it there, and set its
# permissions so only the sentinelforge user and root can read it:
#
#   sudo install -d -m 0750 -o root -g sentinelforge /etc/sentinelforge
#   sudo install -m 0640 -o root -g sentinelforge \
#       packaging/systemd/sentinelforge.env.example \
#       /etc/sentinelforge/sentinelforge.env
#   sudo $EDITOR /etc/sentinelforge/sentinelforge.env
#
# Every unit file loads this with EnvironmentFile=-/etc/sentinelforge/... -
# the leading '-' means a missing file is not an error, so every service
# still starts with sane built-in defaults if you never create it at all.

# -- dashboard ---------------------------------------------------------------
# Loopback only, by design (see the README's "Local security and remote
# exposure" section) - do not set this to 0.0.0.0 without putting your own
# authenticating reverse proxy in front of it first.
#SENTINELFORGE_DASHBOARD_HOST=127.0.0.1
#SENTINELFORGE_DASHBOARD_PORT=8080

# -- periodic scan -------------------------------------------------------
# Passed straight to `sentinelforge collect --since`; keep it comfortably
# wider than sentinelforge-scan.timer's OnUnitActiveSec so overlapping runs
# never miss an event between them (reprocessing the overlap is safe - see
# sentinelforge-scan.service's comment on idempotence).
#SENTINELFORGE_SCAN_WINDOW=10 minutes ago

# -- where the installed console script actually is --------------------
# NOT an environment variable: systemd does not expand environment variables
# in the executable position of a unit's ExecStart= (only in the arguments
# that follow it), so the sentinelforge binary path is hardcoded directly in
# each .service file's ExecStart= line instead. If `command -v sentinelforge`
# (as the account the service runs as) is not /usr/local/bin/sentinelforge,
# edit that line in the unit file before installing it -
# scripts/install-systemd-service.sh does this substitution for you
# automatically.

# -- AI SOC analyst (Phase 5) - optional, only read by `sentinelforge ai`,
# never by the dashboard or scan units above -----------------------------
# Leave unset to use the offline mock provider (no key, no network, no cost).
# SentinelForge never writes this value anywhere - not to a log, not to the
# incident database, not to a file it creates. Treat this file itself as a
# secret (mode 0640, group-readable only by the service account) once you do
# set a real key here.
#SENTINELFORGE_LLM_PROVIDER=openai
#SENTINELFORGE_LLM_MODEL=REPLACE_WITH_YOUR_MODEL_ID
#SENTINELFORGE_LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY
#SENTINELFORGE_LLM_BASE_URL=https://api.openai.com/v1
