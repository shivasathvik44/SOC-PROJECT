# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
*.egg
.tox/
.pytype/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# SentinelForge output (never commit collected logs - they contain host data)
*.jsonl
events.jsonl
out/
*.db
incidents.db

# Secrets: API keys for LLM providers are read from the environment only and
# must never be committed (Phase 5).
.env
.env.*
!.env.example
*.key
secrets/

# Cached AI analyses (they contain incident content)
.sentinelforge-cache/
ai-analyses/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Phase 8 validation reports are *generated* from a run on one machine, and
# their numbers (kernel version, CPU, timestamps, absolute file paths) describe
# that machine, not the code. The whole directory is ignored so a routine
# `git add .` cannot pick up a stray run - commit a specific report only
# deliberately, with `git add -f`, as evidence of one validation run. The
# reports themselves contain synthetic scenario data only, never real
# telemetry.
reports/
